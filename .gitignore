# ── Dependencies ──────────────────────────────────────────────────────────
node_modules/

# ── Build output ──────────────────────────────────────────────────────────
dist/
cardproof-dist/

# ── Vite ──────────────────────────────────────────────────────────────────
*.local

# ── Local-only dev modules (personal cheats / scratch tools; never committed) ─
# Loaded in dev by the import.meta.glob('./dev/*.local.ts') hook in src/main.ts.
# NOTE: the `*.local` rule above does NOT cover these (it only matches names
# ending in `.local`), so this explicit `*.local.ts` rule is required.
*.local.ts

# ── Generated art manifest (rebuilt by `npm run gen-art-manifest`) ────────
src/data/art-manifest.json

# ── Derived half-res mobile art (rebuilt by `npm run gen-art-halfres`) ────
public/assets/art/cards-half/

# ── Local-only balance workbench (card reference + power analysis; never committed) ─
balance/
scripts/card-reference.ts
# The Blades card DB and its health detectors (dupes/dominated/inert/curve/health).
# Reads our own CardDef data rather than oracle text. Rebuild with:
#   npx tsx scripts/blades-db.ts build
scripts/blades-db.ts
# The card health pass contract, which quotes the gitignored workbench paths above.
docs/plan-card-health-pass.md
# Session handoffs and the premium-UX ideation set: local-only working docs that
# quote worktree paths, Codex task ids, and internal design deliberations.
docs/handoff-1-5-close.md
docs/plan-premium-ux.md
docs/plan-premium-ux-opus-lane.md
docs/plan-premium-ux-sol-lane.md

# ── Local MTG reference workbench (never committed) ───────────────────────
# The corpus itself: third-party card data + a derived SQLite file. Large,
# regenerable, and not ours to redistribute.
mtg-cache/
# The tooling that builds and queries it, kept local-only alongside the
# card-reference workbench above. Rebuild with:
#   npx tsx scripts/mtg-db.ts build --printings --tags
scripts/mtg-db.ts
docs/mtg-reference-db.md
docs/mtg-db-playbook.md

# ── Logs ──────────────────────────────────────────────────────────────────
.artcrop-staging/

*.log

# ── Local Claude Code settings (launch.json is tracked; local overrides not)
.claude/settings.local.json

# (src-tauri/target and src-tauri/gen/schemas are ignored by src-tauri/.gitignore)
scripts/codex-dash/.cache/
